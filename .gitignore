# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
venv/
env/
.venv/
.env/

# Environment variables
.env

# IDE settings
.vscode/
.idea/
.claude/
.pi/

# Distribution / packaging
dist/
*.egg-info/

# PyInstaller intermediates + Inno Setup output (build scripts/specs are kept).
# Both build.ps1 and build-electron.ps1 pass --workpath build\build
build/build/
build/Output/

# Fallback: if PyInstaller is run directly (no --workpath), it writes
# intermediates to build/<spec-name>/. Guard the Electron back-end build name.
build/LogNotes/

# Local development
*.log
*.tmp

# Model cache
.cache/
models/

# Config (user-specific)
config.json

# Node / Electron
node_modules/
electron/node_modules/
electron/out/
dist-electron/

# Local-only reference files for development purposes
archive/
documentation/implementations/
CLAUDE.local.md

# OS files
.DS_Store
Thumbs.db
